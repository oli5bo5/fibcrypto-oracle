# ==============================================================================
# FibCrypto Oracle — Server & Provider Configuration
# ==============================================================================
# Kopieren Sie diese Datei nach 'config.env' und tragen Sie Ihre Keys ein (optional).
# Das System funktioniert ohne Keys out-of-the-box über OKX, Kraken und Yahoo Finance!

# Server Host & Port
SERVER_HOST=127.0.0.1
SERVER_PORT=8085

# Optional: Finnhub API Key (Kostenlos auf https://finnhub.io, 60 Calls/min)
# Wird als sekundäre Fallback-Quelle für Aktien-Quotes verwendet
FINNHUB_API_KEY=

# Optional: Twelve Data API Key (Kostenlos auf https://twelvedata.com, 800 Calls/Tag)
# Wird als tertiäre Fallback-Quelle für Aktien verwendet
TWELVEDATA_API_KEY=

# Cache Time-To-Live in Sekunden
CACHE_CRYPTO_TICKER_SEC=5
CACHE_CRYPTO_KLINES_SEC=60
CACHE_STOCK_QUOTE_SEC=60
CACHE_STOCK_KLINES_SEC=900
